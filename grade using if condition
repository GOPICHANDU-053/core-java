       Scanner sc = new Scanner(System.in);
       System.out.print("Enter the marks: ");
        int marks = sc.nextInt();
        
	if(marks<35) {
		System.out.println("the student failed");
	}
	if(marks==35) {
		System.out.println("the student is secured pass");
	}
	if(marks>35&&marks<70) {
		System.out.println("the student is third class");
	}
	if(marks>70&&marks<85) {
		System.out.println("the student is second class");
	}
	   if (marks>85){
		System.out.println("the student is first class");
	}
 sc.close();
}
}
